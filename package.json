{
  "name": "guri-gacaferi-portfolio",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://gurigacaferi.github.io/portfolio",
  "scripts": {
    "dev": "craco start",
    "build": "craco build",
    "test": "craco test",
    "eject": "react-scripts eject",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx}'",
    "lint-fix": "eslint --fix --ext .js ./",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,css,scss}'"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js}": [
      "eslint --fix --ext .js ./"
    ],
    "package.json": [
      "sort-package-json"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {}
  },
  "dependencies": {
    "@craco/craco": "^7.0.0",
    "framer-motion": "^7.10.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.8.0",
    "react-pdf": "^10.4.1",
    "react-scripts": "5.0.1",
    "web-vitals": "^3.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.21.3",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/preset-env": "^7.21.4",
    "@babel/preset-react": "^7.18.6",
    "ajv": "^8.18.0",
    "autoprefixer": "^10.4.14",
    "babel-jest": "^29.7.0",
    "husky": "^8.0.0",
    "lint-staged": "^13.2.2",
    "postcss": "^8.4.21",
    "sort-package-json": "^1.52.0",
    "tailwindcss": "^3.3.2",
    "typescript": "5.0.4"
  }
}
